{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bank.schema.json",
  "title": "Question bank",
  "type": "object",
  "required": ["version", "questions"],
  "additionalProperties": false,
  "$defs": {
    "letter": { "enum": ["A", "B", "C", "D"] },
    "tagList": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["error", "score", "source"],
        "additionalProperties": false,
        "properties": {
          "error": { "type": "string", "pattern": "^E[0-9]{3}$" },
          "score": { "type": "number", "minimum": -1, "maximum": 1 },
          "source": { "enum": ["gold", "model"] }
        }
      }
    }
  },
  "properties": {
    "version": { "const": 1 },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "topic", "stem", "options", "answer", "tags"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "topic": { "type": "string", "minLength": 1 },
          "skill": { "type": "string" },
          "difficulty": { "type": "string" },
          "stem": { "type": "string", "minLength": 1, "description": "Markdown with $...$ LaTeX" },
          "options": {
            "type": "object",
            "required": ["A", "B", "C", "D"],
            "additionalProperties": false,
            "properties": {
              "A": { "type": "string", "minLength": 1 },
              "B": { "type": "string", "minLength": 1 },
              "C": { "type": "string", "minLength": 1 },
              "D": { "type": "string", "minLength": 1 }
            }
          },
          "answer": { "$ref": "#/$defs/letter" },
          "solution": { "type": "string" },
          "tags": {
            "type": "object",
            "description": "One entry per distractor (never the correct option), best first. An empty list means no clear diagnosis.",
            "additionalProperties": false,
            "properties": {
              "A": { "$ref": "#/$defs/tagList" },
              "B": { "$ref": "#/$defs/tagList" },
              "C": { "$ref": "#/$defs/tagList" },
              "D": { "$ref": "#/$defs/tagList" }
            }
          }
        }
      }
    }
  }
}
