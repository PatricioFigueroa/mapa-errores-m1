{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog.schema.json",
  "title": "Misconception catalogue",
  "type": "object",
  "required": ["version", "language", "items"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "language": { "type": "string", "minLength": 2 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "topic", "activity"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^E[0-9]{3}$" },
          "name": { "type": "string", "minLength": 1, "description": "Text that gets embedded" },
          "description": { "type": "string" },
          "topic": { "type": "string", "minLength": 1 },
          "activity": { "type": "string", "description": "Hand-written reinforcement activity, Markdown with $...$ LaTeX" }
        }
      }
    }
  }
}
