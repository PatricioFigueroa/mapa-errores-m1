{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Artifact manifest",
  "type": "object",
  "required": ["model_id", "variant", "dim", "n_catalog", "catalog_sha256", "threshold", "metrics", "created"],
  "additionalProperties": false,
  "properties": {
    "model_id": { "type": "string", "minLength": 1 },
    "variant": { "enum": ["eedi", "libre"] },
    "dim": { "type": "integer", "minimum": 1 },
    "n_catalog": { "type": "integer", "minimum": 1 },
    "catalog_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of catalog.json bytes (LF line endings)" },
    "threshold": { "type": "number", "minimum": -1, "maximum": 1, "description": "Cosine score below which the answer is 'no clear diagnosis'" },
    "metrics": { "type": "object" },
    "created": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" }
  }
}
