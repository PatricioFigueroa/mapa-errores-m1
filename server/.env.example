# Groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=openai/gpt-oss-20b

# Optional local fallback (Ollama, no API key). Use the model name `ollama list` shows.
# Thinking models need reasoning switched off and a long timeout for the first (cold) call.
LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
LLM_FALLBACK_MODEL=qwen-local:q5_k_m
LLM_FALLBACK_REASONING_EFFORT=none
LLM_FALLBACK_TIMEOUT_MS=120000

# The same two optional settings exist for the primary provider:
# LLM_REASONING_EFFORT=
# LLM_TIMEOUT_MS=30000

ALLOWED_ORIGINS=http://localhost:8100,http://localhost:4200
DAILY_CAP=200
PER_MINUTE=10
PORT=3000
